Predator::Predator()
    : Boid(), attack_range_(), attack_speed_(), preferred_height_(100), height_factor_(0.01),
      screen_(Vec3(600, 300, 300)), wind_(), toroidal_() {}

Predator::Predator(const Predator& other)
    : Boid(other), attack_range_(other.attack_range_), attack_speed_(other.attack_speed_),
      preferred_height_(other.preferred_height_), height_factor_(other.height_factor_),
      screen_(other.screen_), wind_(other.wind_), toroidal_(other.toroidal_) {}

Predator::Predator(const GlobalVariables& global_vars,
                   const PredatorVariables& predator_vars)
    : Boid(), attack_range_(predator_vars.attack_range), attack_speed_(predator_vars.attack_speed),
      preferred_height_(global_vars.screen.z() / 3), height_factor_(0.01),
      screen_(global_vars.screen), wind_(global_vars.wind), toroidal_(global_vars.toroidal_bool) {
    if (attack_range_ <= 0) {
        throw std::invalid_argument("attack_range must be greater than 0");
    }
    if (attack_speed_ <= 0) {
        throw std::invalid_argument("attack_speed must be greater than 0");
    }
    Init(); // Chiama il metodo di inizializzazione
}

void Predator::Init() {
    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_real_distribution<> ds(0, 1.0);
    std::uniform_real_distribution<> dv(-1.0, 1.0);

    const double x = ds(gen) * screen_.x();
    const double y = ds(gen) * screen_.y();
    const double z = ds(gen) * screen_.z();
    set_position(Vec3(x, y, z));

    const double max_deviation = attack_speed_ / std::sqrt(3);
    const double vx = dv(gen) * max_deviation;
    const double vy = dv(gen) * max_deviation;
    const double vz = dv(gen) * max_deviation;
    set_velocity(Vec3(vx, vy, vz));

    if (velocity().norm() > attack_speed_) {
        set_velocity(velocity().normalize() * attack_speed_);
    }
}

const Boid* Predator::findPrey(const Swarm& swarm) const {
    const Boid* nearest_prey = nullptr;
    double nearest_distance = screen_.norm();

    for (int i = 0; i < swarm.size(); ++i) {
        const Boid& current_boid = swarm[i]; // Accesso polimorfico
        const double dist = distance(toroidal_, current_boid.position(), position(), screen_);

        if (dist < nearest_distance && dist <= attack_range_) {
            nearest_distance = dist;
            nearest_prey = &current_boid;
        }
    }
    return nearest_prey;
}

void Predator::attack(Swarm& swarm) {
    const Boid* prey = findPrey(swarm);
    if (prey) {
        // La preda viene rimossa dallo stormo dalla logica dello Swarm::updateSwarm
        // quindi qui la logica si concentra solo sul movimento del predatore verso la preda.
        Vec3 prey_position = prey->position();
        Vec3 direction_to_prey = vecDistance(toroidal_, prey_position, position(), screen_).normalize();
        set_velocity(direction_to_prey * attack_speed_);
    }
}

// **Implementazione del metodo update_behavior per Predator**
void Predator::update_behavior(const Swarm& swarm_context, const Predator* predator_ptr,
                               const Vec3& global_wind, const Vec3& global_screen,
                               bool global_toroidal) {
    // La logica di cooldown è gestita dallo swarm, ma il predatore potrebbe averne una propria.
    // L'implementazione originale di updatePredator prendeva uno Swarm&.
    // Assumiamo che la logica di cooldown sia ora una responsabilità condivisa.
    // Qui il predatore decide solo la sua prossima mossa.

    // Il metodo `cooldown` non è più nel predatore ma nello swarm [10].
    // Quindi, il predatore non dovrebbe decidere il comportamento basandosi sul cooldown dello swarm.
    // La logica "se swarm.cooldown() >= 1000 allora attacca" deve essere spostata
    // nella funzione che chiama update_behavior del predatore, probabilmente in `updateSimulation` o `Swarm::updateSwarm`.

    // Per semplicità, qui il predatore attacca se trova una preda nel raggio, altrimenti mantiene altezza.
    const Boid* prey = findPrey(swarm_context); // Usiamo lo swarm passato come contesto
    if (prey) {
        // Se c'è una preda nel raggio, il predatore si muove per attaccarla
        attack(const_cast<Swarm&>(swarm_context)); // Necessario const_cast per modificare lo swarm se attack lo facesse.
                                                 // Nell'implementazione data, attack non modifica lo swarm ma il predatore stesso.
    } else {
        // Se non ci sono prede nel raggio o non è il momento di attaccare, il predatore si muove per mantenere l'altezza preferita
        apply_delta_velocity(maintainHeight(*this, preferred_height_, height_factor_), attack_speed_ / 2);
    }

    // Applica il vento e il movimento base
    apply_movement(global_wind); // this updates position_ based on velocity_

    // Applica i bordi toroidali o di rimbalzo
    border(global_screen, global_toroidal, *this);
}

} // namespace boids
