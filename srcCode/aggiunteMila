namespace boids {

class Swarm {
    // **Modifica fondamentale: usa unique_ptr per polimorfismo** [2]
    std::vector<std::unique_ptr<Boid>> boids_;
    int size_; // Il numero attuale di boids nello stormo

    // **Rimuovi i parametri di flocking da Swarm**: Ora sono in Prey.
    // const double wingspan_; // Spostato in Prey
    // const double max_speed_; // Spostato in Prey
    // ... e tutti gli altri fattori di flocking

    // Variabili globali o di contesto che lo Swarm gestisce
    const Vec3 screen_;
    const Vec3 wind_;
    const bool toroidal_;
    const Boid* predator_; // Puntatore raw non-owning al predatore (se presente)

    int cooldown_; // Per la logica di attacco del predatore

    // Metodi privati o helper
    // isWithinRange potrebbe diventare una funzione globale se non usa membri specifici di Swarm
    // per ora, la lascio qui come helper per facilità.
    bool isWithinRange(const Boid& b1, const Boid& b2, double range, const Vec3& global_screen, bool global_toroidal) const;

    void Init(); // Inizializza le posizioni/velocità iniziali dei boids

public:
    Swarm();
    // Swarm(const Swarm& other); // Il copy constructor di Swarm sarà più complesso a causa di unique_ptr.
                               // Se non strettamente necessario, potresti disabilitarlo (= delete). [11]
                               // Per ora, lo lascio commentato come nel tuo codice.

    Swarm(const GlobalVariables& global_vars, const SwarmVariables& swarm_vars,
          const Boid* predator);

    // Operatori di accesso agli elementi dello stormo [2]
    Boid& operator[](int i);
    const Boid& operator[](int i) const;

    // Getter
    int size() const;
    // Rimuovi getter per fattori di flocking, ora sono in Prey
    const Vec3& screen() const;
    const Vec3& wind() const;
    bool toroidal() const;
    int cooldown() const;

    void set_predator(const Boid* predator);

    void updateSwarm(); // Metodo principale per aggiornare lo stormo
};

// Implementazioni inline
// isWithinRange: ora prende i parametri global_screen e global_toroidal esplicitamente.
inline bool Swarm::isWithinRange(const Boid& b1, const Boid& b2, double range,
                                 const Vec3& global_screen, bool global_toroidal) const {
    return distance(global_toroidal, b1.position(), b2.position(), global_screen) <= range;
}

// operator[]: dereferenzia il unique_ptr [2]
inline Boid& Swarm::operator[](int i) {
    if (i < 0 || i >= size_) { throw std::out_of_range("Index out of range"); }
    return *boids_[static_cast<std::size_t>(i)]; // Dereferenzia il puntatore
}

inline const Boid& Swarm::operator[](int i) const {
    if (i < 0 || i >= size_) { throw std::out_of_range("Index out of range"); }
    return *boids_[static_cast<std::size_t>(i)]; // Dereferenzia il puntatore
}

inline int Swarm::size() const { return size_; } // Aggiornato per riflettere il campo size_
inline const Vec3& Swarm::screen() const { return screen_; }
inline const Vec3& Swarm::wind() const { return wind_; }
inline bool Swarm::toroidal() const { return toroidal_; }
inline int Swarm::cooldown() const { return cooldown_; }
inline void Swarm::set_predator(const Boid* predator) { predator_ = predator; }

} // namespace boids

#endif // SWARM_HPP
