    boids::initializeShapes(swarm_vars.wingspan, boid_shape, predator_shape); // wingspan ora è nella Prey

    // Creazione del predatore come unique_ptr<Predator> [12]
    std::unique_ptr<boids::Predator> predator = nullptr;
    if (global_vars.predator_bool) {
        predator = std::make_unique<boids::Predator>(global_vars, predator_vars);
    }

    // Passa un puntatore raw (non-owning) al predatore allo swarm [13]
    boids::Swarm swarm(global_vars, swarm_vars, predator.get());

    int t = 0;
    const int print_period = 100;
    const float target_frame_time = 1.0f / 180.0f;

    while (window_top.isOpen() && window_side.isOpen() && swarm.size() > 1) {
        sf::Clock clock;

        boids::handleEvents(window_top);
        boids::handleEvents(window_side);

        window_top.clear();
        boids::drawBoids(predator.get(), swarm, window_top, 0, boid_shape, predator_shape);
        window_top.display();

        window_side.clear();
        boids::drawBoids(predator.get(), swarm, window_side, 1, boid_shape, predator_shape);
        window_side.display();

        // Aggiorna lo stormo e il predatore.
        // updateSimulation dovrebbe chiamare updateSwarm e update_behavior del predatore.
        // La logica di cooldown per il predatore dovrebbe essere qui o in update_behavior del predatore.
        // Ad esempio, potresti passare lo swarm al predatore per findPrey, ma l'attivazione
        // dell'attacco potrebbe essere controllata qui o da una logica nel predatore stesso.
        // Per ora, chiamo updateSwarm e update_behavior del predatore separatamente.
        swarm.updateSwarm();
        if (predator) {
            // Nota: predator_ptr è il predatore stesso, quindi potremmo passare nullptr
            // per il suo stesso `predator_ptr` o il puntatore a se stesso.
            // L'implementazione attuale di Predator::updatePredator non usa il parametro predator_ptr ricorsivamente.
            predator->update_behavior(swarm, predator.get(), global_vars.wind, global_vars.screen, global_vars.toroidal_bool);
        }

        boids::updateSimulation(predator.get(), swarm, t, print_period, "boids_save.txt");


        float frame_time = clock.getElapsedTime().asSeconds();
        if (frame_time < target_frame_time) {
            sf::sleep(sf::seconds(target_frame_time - frame_time));
        }
    }

    return 0;
}
