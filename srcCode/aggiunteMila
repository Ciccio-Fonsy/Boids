      cohesion_factor_(cohesion_factor), alignment_factor_(alignment_factor),
      fear_factor_(fear_factor), height_factor_(height_factor) {}

// Implementazione della logica di flocking spostata da Swarm a Prey
Vec3 Prey::calculate_separation(const Swarm& swarm_context, const Vec3& global_screen, bool global_toroidal) const {
    Vec3 c;
    for (int i = 0; i < swarm_context.size(); ++i) {
        const Boid& other_boid = swarm_context[i]; // Accesso polimorfico
        if (&other_boid != this) { // Evita di confrontare con se stesso
             // Solo se l'altra boid è una Prey e nel range
            const Prey* other_prey = dynamic_cast<const Prey*>(&other_boid);
            if (other_prey && isWithinRange(*this, *other_prey, min_distance_, global_screen, global_toroidal) && other_prey->position() != position()) {
                const Vec3 separation_vector = vecDistance(global_toroidal, other_prey->position(), position(), global_screen);
                c -= separation_vector.normalize() / separation_vector.norm();
            }
        }
    }
    return c * separation_factor_;
}

Vec3 Prey::calculate_cohesion(const Swarm& swarm_context, const Vec3& global_screen, bool global_toroidal) const {
    Vec3 perceived_center;
    int count = 0;
    for (int i = 0; i < swarm_context.size(); ++i) {
        const Boid& other_boid = swarm_context[i];
        if (&other_boid != this) {
            const Prey* other_prey = dynamic_cast<const Prey*>(&other_boid);
            if (other_prey && isWithinRange(*this, *other_prey, sight_distance_, global_screen, global_toroidal)) {
                Vec3 position_to_add = other_prey->position();
                if (global_toroidal) {
                    // Logica aggiustamento per toroidale
                    for (int j = 0; j < 2; ++j) {
                        double pos_diff = position_to_add[j] - perceived_center[j];
                        if (std::abs(pos_diff) >= global_screen[j] / 2) {
                            position_to_add[j] += (pos_diff < 0 ? global_screen[j] : -global_screen[j]);
                        }
                        // Questo non è l'approccio standard per la media in un toro
                        // Potrebbe essere necessario un approccio più robusto per la coesione toroidale.
                        // Per semplicità, qui usiamo l'implementazione fornita per la media.
                        perceived_center[j] = (count * perceived_center[j] + position_to_add[j]) / (count + 1);
                        perceived_center[j] = std::fmod(perceived_center[j] + global_screen[j], global_screen[j]);
                    }
                    perceived_center[6] += position_to_add[6]; // Z non toroidale
                } else {
                    perceived_center += position_to_add;
                }
                ++count;
            }
        }
    }
    if (count == 0) { return Vec3(0, 0, 0); }

    if (global_toroidal) {
        perceived_center[6] /= count;
    } else {
        perceived_center /= count;
    }

    return vecDistance(global_toroidal, perceived_center, position(), global_screen) * cohesion_factor_;
}

Vec3 Prey::calculate_alignment(const Swarm& swarm_context, const Vec3& global_screen) const {
    Vec3 pv;
    int count = 0;
    for (int i = 0; i < swarm_context.size(); ++i) {
        const Boid& other_boid = swarm_context[i];
        if (&other_boid != this) {
            const Prey* other_prey = dynamic_cast<const Prey*>(&other_boid);
            if (other_prey && isWithinRange(*this, *other_prey, min_distance_, global_screen, false)) { // Min_distance non ha logica toroidale qui
                pv += other_prey->velocity();
                ++count;
            }
        }
    }
    if (count == 0) { return Vec3(0, 0, 0); }
    pv /= count;
    return (pv - velocity()) * alignment_factor_;
}

Vec3 Prey::calculate_fear(const Predator* predator_ptr, const Vec3& global_screen, bool global_toroidal) const {
    Vec3 evade_vector;
    if (predator_ptr) {
        const Vec3 distance_to_predator = vecDistance(global_toroidal, position(), predator_ptr->position(), global_screen);
        const double distance_norm = distance_to_predator.norm();

        if (distance_norm == 0) {
            evade_vector = velocity().normalize() * max_speed_;
        } else if (distance_norm <= sight_distance_) {
            const Vec3 flee_direction = distance_to_predator.normalize();
            const double evade_strength = (sight_distance_ - distance_norm) / sight_distance_;
            evade_vector = flee_direction * max_speed_ * evade_strength;
        }
    }
    return evade_vector * fear_factor_;
}

void Prey::handle_bounce(Swarm& swarm_context, const Vec3& global_screen, bool global_toroidal) {
    // Nota: La logica `bounce` originale iterava sullo swarm e modificava anche `other_boid`.
    // Qui è la singola Prey che gestisce la sua interazione.
    // L'interazione deve essere simmetrica, quindi probabilmente questa logica andrebbe
    // gestita esternamente o in modo che ogni boid influenzi solo se stesso o entrambi.
    // Per ora, replico la logica così com'era, ma potresti volerla rivedere per evitare collisioni doppie o incomplete.

    // Trova solo i boids di tipo Prey con cui interagire per il rimbalzo
    for (int i = 0; i < swarm_context.size(); ++i) {
        Boid& other_boid_base = swarm_context[i];
        if (&other_boid_base != this) {
            Prey* other_boid_prey = dynamic_cast<Prey*>(&other_boid_base);
            if (other_boid_prey && isWithinRange(*this, *other_boid_prey, 2 * wingspan_, global_screen, global_toroidal)) {
                // Logica di collisione per evitare sovrapposizioni e rimbalzo
                if (position() == other_boid_prey->position()) {
                    set_position(position() + Vec3(0, 0, wingspan_ / 10)); // Piccolo spostamento per evitare coincidenza
                }

                const Vec3 separation_vector = vecDistance(global_toroidal, other_boid_prey->position(), position(), global_screen);
                const Vec3 relative_velocity = velocity() - other_boid_prey->velocity();
                const bool approaching = separation_vector.dot(relative_velocity) > 0;

                if (approaching) {
                    const Vec3 collision_normal = separation_vector.normalize();
                    const Vec3 velocity_b_after = velocity() - collision_normal * (relative_velocity.dot(collision_normal));
                    const Vec3 velocity_other_after = other_boid_prey->velocity() + collision_normal * (relative_velocity.dot(collision_normal));

                    set_velocity(velocity_b_after * 0.1);
                    other_boid_prey->set_velocity(velocity_other_after * 0.1); // Modifica l'altro boid, attenzione!
                }
            }
        }
    }
}

// Implementazione del metodo update_behavior per Prey
void Prey::update_behavior(const Swarm& swarm_context, const Predator* predator_ptr,
                           const Vec3& global_wind, const Vec3& global_screen,
                           bool global_toroidal) {
    Vec3 delta_v;

    // Applica le regole di flocking
    delta_v += calculate_separation(swarm_context, global_screen, global_toroidal);
    delta_v += calculate_cohesion(swarm_context, global_screen, global_toroidal);
    delta_v += calculate_alignment(swarm_context, global_screen);
    delta_v += maintainHeight(*this, preferred_height_, height_factor_); // maintainHeight è una funzione libera

    // Applica la logica di paura se presente un predatore
    if (predator_ptr) {
        delta_v += calculate_fear(predator_ptr, global_screen, global_toroidal);
    }

    // Applica il cambio di velocità e limita la velocità [7]
    apply_delta_velocity(delta_v, max_speed_);

    // Applica il vento e il movimento base
    apply_movement(global_wind); // this updates position_ based on velocity_

    // Applica i bordi toroidali o di rimbalzo [8, 9]
    border(global_screen, global_toroidal, *this);

    // Gestisci il rimbalzo con altri boids (collisioni)
    // Nota: handle_bounce modifica anche altri boid, potresti volerlo spostare o gestirlo diversamente
    // se non vuoi che ogni Prey modifichi altre Prey.
    handle_bounce(const_cast<Swarm&>(swarm_context), global_screen, global_toroidal);
}

} // namespace boids
