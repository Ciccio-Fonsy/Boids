namespace boids {

void Swarm::Init() {
    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_real_distribution<> ds(0, 1.0);
    std::uniform_real_distribution<> dv(-1.0, 1.0);

    // Inizializza i boids. Ora sono std::unique_ptr<Prey>.
    for (int i = 0; i < size_; ++i) {
        // Creiamo Prey con valori di default o da GlobalVariables/SwarmVariables
        // Qui usiamo i valori hardcoded per Prey, ma potresti passarli.
        boids_[static_cast<std::size_t>(i)] = std::make_unique<Prey>(); // Crea una Prey di default [12]

        // Imposta posizione e velocità iniziali
        const double x = ds(gen) * screen_.x();
        const double z = ds(gen) * screen_.z();
        const double y = ds(gen) * screen_.y();
        boids_[static_cast<std::size_t>(i)]->set_position(Vec3(x, y, z));

        // Velocità iniziale, usa il max_speed specifico della Prey
        // Poiché boids_ contiene Boid*, dobbiamo dynamic_cast o assicurare che
        // max_speed sia accessibile polimorficamente (ad es., un getter virtuale in Boid)
        // O, più semplice, creare la Prey con tutti i suoi parametri nel costruttore.
        // Per ora, useremo un valore generico per l'inizializzazione random, ma la Prey applicherà la sua `max_speed_`.
        double current_max_speed = 1.0; // Placeholder, idealmente da Prey::max_speed()
        Prey* current_prey = dynamic_cast<Prey*>(boids_[static_cast<std::size_t>(i)].get());
        if(current_prey) {
            current_max_speed = current_prey->max_speed();
        }

        double max_deviation = current_max_speed / std::sqrt(3);
        const double vx = dv(gen) * max_deviation;
        const double vy = dv(gen) * max_deviation;
        const double vz = dv(gen) * max_deviation;
        boids_[static_cast<std::size_t>(i)]->set_velocity(Vec3(vx, vy, vz));

        if (boids_[static_cast<std::size_t>(i)]->velocity().norm() > current_max_speed) {
            boids_[static_cast<std::size_t>(i)]->set_velocity(boids_[static_cast<std::size_t>(i)]->velocity().normalize() * current_max_speed);
        }
    }
}

// Costruttore di default
Swarm::Swarm()
    : size_(100), screen_(Vec3(600, 300, 300)), wind_(), toroidal_(), predator_(nullptr), cooldown_() {
    boids_.resize(static_cast<std::size_t>(size_)); // Pre-alloca spazio per i puntatori
    Init();
}

// Costruttore parametrico
Swarm::Swarm(const GlobalVariables& global_vars,
             const SwarmVariables& swarm_vars, const Boid* predator)
    : size_(swarm_vars.size), screen_(global_vars.screen), wind_(global_vars.wind),
      toroidal_(global_vars.toroidal_bool), predator_(predator), cooldown_() {
    if (size_ <= 0) {
        throw std::invalid_argument("Swarm size must be greater than 0");
    }
    // I controlli su wingspan, max_speed, etc. sono ora responsabilità di Prey
    // o di SwarmVariables, non di Swarm direttamente.

    boids_.resize(static_cast<std::size_t>(size_)); // Pre-alloca spazio per i puntatori
    Init(); // Inizializza i boid (creando oggetti Prey concreti)
}

void Swarm::updateSwarm() {
    ++cooldown_;
    std::vector<int> boids_to_remove; // Indici dei boids da rimuovere

    // Pre-calcola le delta_v per evitare modifiche concorrenti durante l'iterazione
    // In un sistema più complesso, potresti voler usare algoritmi paralleli o una copia.

    for (int i = 0; i < size_; ++i) {
        // Accedi all'oggetto Boid tramite il puntatore intelligente
        Boid* current_boid_ptr = boids_[static_cast<std::size_t>(i)].get();
        if (!current_boid_ptr) continue; // Salta se il puntatore è nullo (non dovrebbe succedere qui)

        // Controllo per la rimozione se catturato dal predatore
        if (predator_ && isWithinRange(*predator_, *current_boid_ptr,
                                       // Usiamo un wingspan generico o lo otteniamo dalla Prey stessa.
                                       // Qui assumiamo che i boid siano Prey per accedere a wingspan().
                                       // Se ci fossero altri tipi di Boid, wingspan dovrebbe essere un getter virtuale.
                                       dynamic_cast<Prey*>(current_boid_ptr) ? dynamic_cast<Prey*>(current_boid_ptr)->wingspan() : 2.0,
                                       screen_, toroidal_)) {
            boids_to_remove.push_back(i);
            cooldown_ = 0;
        } else {
            // Chiamata polimorfica al comportamento specifico [5]
            current_boid_ptr->update_behavior(*this, predator_, wind_, screen_, toroidal_);
        }
    }

    // Rimuovi i boids catturati, iterando al contrario per non invalidare gli indici
    for (auto it = boids_to_remove.rbegin(); it != boids_to_remove.rend(); ++it) {
        boids_.erase(boids_.begin() + static_cast<std::vector<std::unique_ptr<Boid>>::difference_type>(*it));
        --size_; // Decrementa il conteggio dello stormo
    }
}

} // namespace boids
