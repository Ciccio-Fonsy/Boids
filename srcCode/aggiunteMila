class Boid {
    Vec3 position_;
    Vec3 velocity_;

public:
    // Costruttori esistenti
    Boid();
    Boid(const Boid& other);
    Boid(Vec3 position, Vec3 velocity);

    // **Il distruttore deve essere virtuale** per garantire la corretta distruzione degli oggetti derivati
    // quando vengono eliminati tramite un puntatore alla classe base [3].
    virtual ~Boid() = default;

    // Funzioni di accesso (getter)
    Vec3 position() const;
    Vec3 velocity() const;

    // Funzioni di modifica (setter)
    void set_position(const Vec3& new_position);
    void set_velocity(const Vec3& new_velocity);

    // Operatori di confronto e assegnazione
    bool operator==(const Boid& other) const;
    bool operator!=(const Boid& other) const;
    Boid& operator=(const Boid& other);

    // **Funzioni generiche di applicazione del movimento**: rese protette per essere usate dalle classi derivate.
    // Queste non sono il "comportamento" specifico, ma l'applicazione della fisica di base.
    // In alternativa, potresti inglobarle direttamente nel metodo update_behavior delle classi figlie.
    // Ho scelto di mantenerle qui come helper protected per riuso.
protected:
    void apply_velocity_cap(double max_speed);
    void apply_delta_velocity(Vec3 delta_v, double max_speed);
    void apply_movement(Vec3 wind_effect);
    // Nota: la logica `border` è una funzione globale, la chiamerai nel metodo `update_behavior` specifico.

public:
    // **Funzione virtuale pura per il comportamento specifico** [4]
    // Questa funzione sarà implementata in modo diverso per Prey e Predator.
    // I parametri forniranno il contesto necessario per il calcolo del comportamento.
    virtual void update_behavior(const Swarm& swarm_context, const Predator* predator_ptr,
                                 const Vec3& global_wind, const Vec3& global_screen,
                                 bool global_toroidal) = 0;
};

// Implementazioni inline spostate qui sotto la dichiarazione della classe
inline Vec3 Boid::position() const { return position_; }
inline Vec3 Boid::velocity() const { return velocity_; }
inline void Boid::set_position(const Vec3& new_position) { position_ = new_position; }
inline void Boid::set_velocity(const Vec3& new_velocity) { velocity_ = new_velocity; }
inline bool Boid::operator==(const Boid& other) const {
    return position_ == other.position_ && velocity_ == other.velocity_;
}
inline bool Boid::operator!=(const Boid& other) const {
    return !(*this == other);
}
inline Boid& Boid::operator=(const Boid& other) {
    if (this != &other) {
        position_ = other.position_;
        velocity_ = other.velocity_;
    }
    return *this;
}

